&lt;button type="button" class="copy-code-button background" aria-label="Copiar código" title="Copiar código"&gt;&lt;em class="fas fa-copy" aria-hidden="true"&gt;&lt;/em&gt;&lt;em class="fas fa-check" aria-hidden="true"&gt;&lt;/em&gt;&lt;span&gt;Copiar&lt;/span&gt;&lt;/button&gt;
&lt;/div&gt;&lt;div class="chroma"&gt;
&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;
&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1
