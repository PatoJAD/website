{{- $index := slice -}}
{{- range where .Site.RegularPages "Params.hidden" "!=" true -}}
  {{- $index = $index | append (dict "title" .Title "content" (.Plain | truncate 500 "") "permalink" .Permalink "img" .Params.img "summary" (.Summary | plainify | truncate 200 "") "date" (.Date.Format "2 Jan 2006")) -}}
{{- end -}}
{{- $index | jsonify -}}
