{
  "name": "patojad-website",
  "description": "Sitio web oficial de PatoJAD — blog de tecnología, GNU/Linux y desarrollo, hecho con Hugo (Extended) y Tailwind CSS.",
  "private": true,
  "scripts": {
    "dev": "hugo server",
    "build": "hugo --minify --enableGitInfo",
    "deploy": "bash deploy.sh",
    "stats": "node scripts/fetch-stats.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "hugo-extended": "0.164.0",
    "tailwindcss": "^4.3.3"
  },
  "trustedDependencies": [
    "hugo-extended"
  ]
}
