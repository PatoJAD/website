{{- $index := slice -}}
{{- range .Site.RegularPages -}}
  {{- $index = $index | append (dict "title" .Title "content" (.Plain | truncate 2000 "") "permalink" .Permalink "img" .Params.img "summary" (.Summary | plainify | truncate 200 "") "date" (.Date.Format "2 Jan 2006")) -}}
{{- end -}}
{{- $index | jsonify -}}
